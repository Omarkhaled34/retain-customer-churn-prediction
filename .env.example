# Local development defaults. Generate secrets with python scripts/create_env.py.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
POSTGRES_PASSWORD=
DB_ADMIN_PASSWORD=
# Leave unset to use SQLite for local development. Docker always uses PostgreSQL.
# DATABASE_URL=postgresql://churn:URL_ENCODED_PASSWORD@localhost:5432/churn
# MODEL_PATH=/absolute/path/to/churn.joblib
# Set only for direct frontend-to-backend requests. The Vite and nginx proxies default to /api.
# VITE_API_BASE_URL=/api
# Production: set DJANGO_DEBUG=false, your domain in ALLOWED_HOSTS, HTTPS origins above, and TLS_CERT_DIR.
# TLS_CERT_DIR=/absolute/path/to/certificates
